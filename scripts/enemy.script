local enemy_manager = require("scripts.enemy_manager")

local BURST_SPEED = 220
local BURST_LIFETIME = 1.5

local FREEZE_DURATION = 3.0
local BLINK_DURATION = 0.15
local REJOIN_SPEED = 50 -- speed once it resumes chasing solo after a freeze

local THROW_SPEED = 150
local THROW_BOUND_MARGIN = 60 -- rough cleanup bounds if a thrown slime somehow misses the player

function final(self)
	if not self.left_cluster then
		enemy_manager.unregister(go.get_id())
	end
end

function update(self, dt)
	if self.bursting then
		go.set_position(go.get_position() + self.burst_velocity * dt)
		self.burst_timer = self.burst_timer - dt
		if self.burst_timer <= 0 then
			go.delete()
		end
		return
	end

	if self.thrown then
		local pos = go.get_position() + self.thrown_velocity * dt
		go.set_position(pos)
		if pos.x < -THROW_BOUND_MARGIN or pos.x > 416 + THROW_BOUND_MARGIN
		or pos.y < -THROW_BOUND_MARGIN or pos.y > 342 + THROW_BOUND_MARGIN then
			go.delete()
		end
		return
	end

	if self.frozen then
		self.freeze_timer = self.freeze_timer - dt
		if self.freeze_timer <= 0 then
			self.frozen = false
			go.cancel_animations("#sprite", "tint")
			go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
			msg.post("#collisionobject", "enable")

			-- Rejoin the matching system as a fresh solo cluster so it's a
			-- normal, shootable enemy again while it chases the player.
			local cluster_id = enemy_manager.new_cluster_id()
			enemy_manager.create_cluster(cluster_id, go.get_position(), REJOIN_SPEED)
			enemy_manager.register(go.get_id(), self.color, cluster_id, vmath.vector3(0, 0, 0))
			self.left_cluster = false
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		self.color = message.color
		sprite.play_flipbook("#sprite", hash(self.color))

	elseif message_id == hash("pop") then
		go.delete()

	elseif message_id == hash("burst") then
		self.bursting = true
		self.left_cluster = true
		enemy_manager.unregister(go.get_id())
		msg.post("#collisionobject", "disable")
		local dir = message.direction or vmath.vector3(0, 1, 0)
		self.burst_velocity = dir * BURST_SPEED
		self.burst_timer = BURST_LIFETIME
		local pos = go.get_position()
		pos.z = math.random() * 0.0001
		go.set_position(pos)
		go.animate("#sprite", "tint", go.PLAYBACK_ONCE_FORWARD, vmath.vector4(1, 1, 1, 0), go.EASING_LINEAR, BURST_LIFETIME)

	elseif message_id == hash("freeze") then
		if self.bursting or self.frozen or self.thrown then return end
		self.left_cluster = true
		enemy_manager.unregister(go.get_id())
		msg.post("#collisionobject", "disable")
		self.frozen = true
		self.freeze_timer = FREEZE_DURATION
		go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.2, go.EASING_LINEAR, BLINK_DURATION)

	elseif message_id == hash("telegraph") then
		-- Boss "about to throw this one" warning blink. Stays in its
		-- cluster (still positioned by enemy_manager) and stays shootable -
		-- a sharp-eyed player can pop it before it launches. The follow-up
		-- "throw" message (sent by boss.script after the telegraph window)
		-- resets the tint, so no separate cleanup timer is needed here.
		if self.bursting or self.frozen or self.thrown then return end
		go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.2, go.EASING_LINEAR, 0.1)

	elseif message_id == hash("throw") then
		if self.bursting or self.frozen or self.thrown then return end
		go.cancel_animations("#sprite", "tint")
		go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
		self.thrown = true
		self.left_cluster = true
		enemy_manager.unregister(go.get_id())

		local player_pos = go.get_position("/player")
		local pos = go.get_position()
		local dir = player_pos - pos
		dir.z = 0
		if vmath.length_sqr(dir) < 0.0001 then
			dir = vmath.vector3(0, -1, 0)
		end
		dir = vmath.normalize(dir)
		self.thrown_velocity = dir * THROW_SPEED
	end
end