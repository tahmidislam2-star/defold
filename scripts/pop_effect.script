go.property("tint", vmath.vector4(1, 1, 1, 1)) -- set by the enemy when it spawns this

local EMITTER_ID = "emitter" -- must match the Id of the emitter inside pop_particles.particlefx

local RING_START_SCALE = 0.4
local RING_END_SCALE = 2.2
local RING_TIME = 0.25
local LIFETIME = 0.7 -- must outlast the particles (duration + particle life time)

function init(self)
	local c = vmath.vector4(self.tint)
	-- the ring sprite is grey, so push its tint toward white to keep it bright
	local ring = vmath.lerp(0.5, c, vmath.vector4(1, 1, 1, 1))

	-- expanding ring: starts small at the slime's origin, scales up and fades out
	go.set("#flash", "tint", ring)
	go.set("#flash", "scale", vmath.vector3(RING_START_SCALE, RING_START_SCALE, 1))
	go.animate("#flash", "scale", go.PLAYBACK_ONCE_FORWARD,
	vmath.vector3(RING_END_SCALE, RING_END_SCALE, 1), go.EASING_OUTQUAD, RING_TIME)
	go.animate("#flash", "tint", go.PLAYBACK_ONCE_FORWARD,
	vmath.vector4(ring.x, ring.y, ring.z, 0), go.EASING_INQUAD, RING_TIME)

	-- coloured sparks (pcall so a wrong emitter id can't crash the game)
	particlefx.play("#particles")
	pcall(particlefx.set_constant, "#particles", EMITTER_ID, "tint", c)

	timer.delay(LIFETIME, false, function() go.delete() end)
end