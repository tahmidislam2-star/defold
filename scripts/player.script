-- player.script

local game_state = require("scripts.game_state")
local enemy_manager = require("scripts.enemy_manager")

local SPEED = 200

local BOUND_MIN_X = 16
local BOUND_MAX_X = 416
local BOUND_MIN_Y = 20
local BOUND_MAX_Y = 342
local RADIUS = 8
local INVULN_DURATION = 1.0
local HITSTOP_DURATION = 0.08 -- bonus: brief freeze-frame on hit

local WALK_SQUISH_SCALE = vmath.vector3(1.1, 0.9, 1)
local WALK_SQUISH_PERIOD = 0.2 -- quick bounce while actively moving

local TILT_ANGLE = 6 -- degrees; flip the sign below if left/right look swapped
local TILT_DURATION = 0.15

local function start_walk_squish(self)
	go.animate("#sprite", "scale", go.PLAYBACK_LOOP_PINGPONG, WALK_SQUISH_SCALE, go.EASING_INOUTSINE, WALK_SQUISH_PERIOD)
end

local function stop_walk_squish(self)
	go.cancel_animations("#sprite", "scale")
	go.set("#sprite", "scale", vmath.vector3(1, 1, 1))
end

local function set_tilt(self, target)
	if self.tilt_target == target then return end
	self.tilt_target = target
	-- Rotating the whole game object (not just "#sprite") because sprite
	-- components don't expose "euler" at all, only a quaternion "rotation".
	-- Safe here since the player's collision shape is a circle, which is
	-- unaffected by rotation either way.
	go.animate(".", "euler.z", go.PLAYBACK_ONCE_FORWARD, target, go.EASING_OUTQUAD, TILT_DURATION)
end

function init(self)
	self.move_up = false
	self.move_down = false
	self.move_left = false
	self.move_right = false
	self.hearts = 3
	self.invulnerable = false
	self.invuln_timer = 0
	self.walking = false
	self.tilt_target = 0
	msg.post(".", "acquire_input_focus")
end

function on_input(self, action_id, action)
	if game_state.game_over then return end

	if action_id == hash("MOVE_UP") then
		if action.pressed then self.move_up = true end
		if action.released then self.move_up = false end
	elseif action_id == hash("MOVE_DOWN") then
		if action.pressed then self.move_down = true end
		if action.released then self.move_down = false end
	elseif action_id == hash("MOVE_LEFT") then
		if action.pressed then self.move_left = true end
		if action.released then self.move_left = false end
	elseif action_id == hash("MOVE_RIGHT") then
		if action.pressed then self.move_right = true end
		if action.released then self.move_right = false end
	end
end

function update(self, dt)
	if game_state.game_over then return end
	if self.invulnerable then
		self.invuln_timer = self.invuln_timer - dt
		if self.invuln_timer <= 0 then
			self.invulnerable = false
			go.cancel_animations("#sprite", "tint")
			go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1))
		end
	end

	local x = (self.move_right and 1 or 0) - (self.move_left and 1 or 0)
	local y = (self.move_up and 1 or 0) - (self.move_down and 1 or 0)
	local input = vmath.vector3(x, y, 0)
	local is_moving = vmath.length_sqr(input) > 0

	if is_moving and not self.walking then
		self.walking = true
		start_walk_squish(self)
	elseif not is_moving and self.walking then
		self.walking = false
		stop_walk_squish(self)
	end

	if x > 0 then
		set_tilt(self, -TILT_ANGLE)
	elseif x < 0 then
		set_tilt(self, TILT_ANGLE)
	else
		set_tilt(self, 0)
	end

	if is_moving then
		local dir = vmath.normalize(input)
		local pos = go.get_position()
		pos = pos + dir * SPEED * dt

		pos.x = math.max(BOUND_MIN_X + RADIUS, math.min(BOUND_MAX_X - RADIUS, pos.x))
		pos.y = math.max(BOUND_MIN_Y + RADIUS, math.min(BOUND_MAX_Y - RADIUS, pos.y))

		go.set_position(pos)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("collision_response") then
		if game_state.game_over or self.invulnerable then return end
		if message.other_group == hash("enemy") then
			self.hearts = self.hearts - 1
			msg.post("/ui#panel", "lose_heart", {})
			msg.post(message.other_id, "freeze")

			self.invulnerable = true
			self.invuln_timer = INVULN_DURATION
			go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.3, go.EASING_LINEAR, 0.1)

			game_state.hitstop_timer = HITSTOP_DURATION

			if self.hearts <= 0 then
				game_state.game_over = true
				msg.post("/ui#panel", "show_game_over", { score = enemy_manager.score, high_score = enemy_manager.high_score })
			end
		end
	end
end