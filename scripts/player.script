-- player.script

local SPEED = 200

local BOUND_MIN_X = 16
local BOUND_MAX_X = 416
local BOUND_MIN_Y = 20
local BOUND_MAX_Y = 342
local RADIUS = 8

function init(self)
	self.move_up = false
	self.move_down = false
	self.move_left = false
	self.move_right = false
	msg.post(".", "acquire_input_focus")
end

function on_input(self, action_id, action)
	if action_id == hash("MOVE_UP") then
		if action.pressed then self.move_up = true end
		if action.released then self.move_up = false end
	elseif action_id == hash("MOVE_DOWN") then
		if action.pressed then self.move_down = true end
		if action.released then self.move_down = false end
	elseif action_id == hash("MOVE_LEFT") then
		if action.pressed then self.move_left = true end
		if action.released then self.move_left = false end
	elseif action_id == hash("MOVE_RIGHT") then
		if action.pressed then self.move_right = true end
		if action.released then self.move_right = false end
	end
end

function update(self, dt)
	local x = (self.move_right and 1 or 0) - (self.move_left and 1 or 0)
	local y = (self.move_up and 1 or 0) - (self.move_down and 1 or 0)
	local input = vmath.vector3(x, y, 0)

	if vmath.length_sqr(input) > 0 then
		local dir = vmath.normalize(input)
		local pos = go.get_position()
		pos = pos + dir * SPEED * dt

		pos.x = math.max(BOUND_MIN_X + RADIUS, math.min(BOUND_MAX_X - RADIUS, pos.x))
		pos.y = math.max(BOUND_MIN_Y + RADIUS, math.min(BOUND_MAX_Y - RADIUS, pos.y))

		go.set_position(pos)
	end
end