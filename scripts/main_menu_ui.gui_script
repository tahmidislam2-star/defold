local HOVER_SCALE_MULT = 1.15
local PRESS_SCALE_MULT = 0.9
local HOVER_DURATION = 0.12
local PRESS_DURATION = 0.08
local FADE_OUT_DURATION = 0.3

local HOVER_COLOR = vmath.vector4(0.2078, 0.5333, 0.3059, 1) -- warm highlight tint
local NORMAL_COLOR = vmath.vector4(1, 1, 1, 1)

local FADE_NODES = { "bg", "title", "Start button", "menu_player", "menu_slime1", "menu_slime2", "menu_slime3", "menu_slime4", "highscore" ,"credits button"} -- "text" fades with it via inherit_alpha

local STAR_MAX = 50 -- most stars visible at once
local STAR_SPAWN_MIN = 0.08 -- seconds between new stars
local STAR_SPAWN_MAX = 0.35
local STAR_FADE_IN = { 0.3, 0.8 }
local STAR_HOLD = { 0.2, 1.2 }
local STAR_FADE_OUT = { 0.3, 0.8 }
local STAR_SCALES = { 1, 2, 2.5 }
local SCREEN_W = 640
local SCREEN_H = 360

local enemy_manager = require("scripts.enemy_manager")
local game_state = require("scripts.game_state")

local CREDITS_LINES = {
	{ "CREDITS", 1.4 },
	{ "", 1 },
	{ "Game design & code", 0.7 },
	{ "Zenvy", 1.0 },
	{ "", 1 },
	{ "Music", 0.7 },
	{ "Retro by MusicWord", 0.6 },
	{ "Big Factory by Retro-BGM-Chan", 0.6 },
	{ "", 1 },
	{ "Made with Defold", 0.8 },
	{ "", 1 },
	{ "Click anywhere to close", 0.6 },
}
local CREDITS_SPACING = 26
local CREDITS_HOVER_MULT = 1.12

local function open_credits(self)
	if self.credits_open then return end
	self.credits_open = true
	self.credit_nodes = {}

	local panel = gui.new_box_node(vmath.vector3(SCREEN_W / 2, SCREEN_H / 2, 0), vmath.vector3(SCREEN_W, SCREEN_H, 0))
	gui.set_color(panel, vmath.vector4(0.05, 0.03, 0.1, 0))
	gui.animate(panel, "color.w", 0.94, gui.EASING_OUTQUAD, 0.25)
	table.insert(self.credit_nodes, panel)

	local font = gui.get_font(gui.get_node("text"))
	local y = SCREEN_H - 50
	for i, line in ipairs(CREDITS_LINES) do
		if line[1] ~= "" then
			local node = gui.new_text_node(vmath.vector3(SCREEN_W / 2, y, 0), line[1])
			gui.set_font(node, font)
			gui.set_scale(node, vmath.vector3(line[2], line[2], 1))
			gui.set_color(node, vmath.vector4(1, 1, 1, 0))
			gui.animate(node, "color.w", 1, gui.EASING_OUTQUAD, 0.3, 0.1 * i)
			table.insert(self.credit_nodes, node)
		end
		y = y - CREDITS_SPACING
	end
end

local function close_credits(self)
	if not self.credits_open then return end
	self.credits_open = false
	local nodes = self.credit_nodes
	self.credit_nodes = nil
	for _, node in ipairs(nodes) do
		gui.animate(node, "color.w", 0, gui.EASING_LINEAR, 0.2)
	end
	timer.delay(0.2, false, function()
		for _, node in ipairs(nodes) do gui.delete_node(node) end
	end)
end

local function set_credits_hover(self, hovering)
	if self.credits_hover == hovering then return end
	self.credits_hover = hovering
	gui.animate(self.credits_btn, gui.PROP_SCALE, hovering and (self.credits_base * CREDITS_HOVER_MULT) or self.credits_base, gui.EASING_OUTQUAD, 0.12)
end

local function rand_range(r)
	return r[1] + math.random() * (r[2] - r[1])
end

local MENU_SLIMES = { "menu_slime1", "menu_slime2", "menu_slime3", "menu_slime4" }

local BOB_HEIGHT = { 4, 9 } -- px each slime rises above its spot
local BOB_DURATION = { 1.6, 2.8 } -- seconds per up or down trip (slow)
local RESPAWN_DELAY = 5.0
local RESPAWN_TIME = 0.5

local POP_GREEN = vmath.vector4(0.45, 1.0, 0.5, 1)
local POP_RING_START = 1.5
local POP_RING_END = 6
local POP_RING_TIME = 0.3
local POP_SPARKS = 12
local POP_SPARK_DIST = { 40, 80 }
local POP_SPARK_TIME = { 0.3, 0.55 }
local POP_SPARK_SCALE = { 2, 4 }

local function start_bob(slime, delay)
	gui.set_position(slime.node, slime.base)
	gui.animate(slime.node, "position.y", slime.base.y + rand_range(BOB_HEIGHT),
	gui.EASING_INOUTSINE, rand_range(BOB_DURATION), delay or 0, nil, gui.PLAYBACK_LOOP_PINGPONG)
end

-- fade in while popping up from small, then resume floating
local function respawn_slime(self, slime)
	if slime.alive then return end
	if self.started then return end
	slime.alive = true
	gui.set_enabled(slime.node, true)
	gui.set_position(slime.node, slime.base)
	gui.set_color(slime.node, vmath.vector4(1, 1, 1, 0))
	gui.set_scale(slime.node, slime.base_scale * 0.3)
	gui.animate(slime.node, "color.w", 1, gui.EASING_OUTQUAD, RESPAWN_TIME)
	gui.animate(slime.node, "scale", slime.base_scale, gui.EASING_OUTBACK, RESPAWN_TIME, 0, function()
		start_bob(slime)
	end)
end

-- green ring + sparks at the slime's position
local function pop_effect(pos)
	local ring = gui.new_box_node(pos, vmath.vector3(16, 16, 0))
	gui.set_texture(ring, "pop_ring")
	gui.play_flipbook(ring, "pop_ring")
	gui.set_blend_mode(ring, gui.BLEND_ADD)
	gui.set_color(ring, POP_GREEN)
	gui.set_scale(ring, vmath.vector3(POP_RING_START, POP_RING_START, 1))
	gui.animate(ring, "scale", vmath.vector3(POP_RING_END, POP_RING_END, 1), gui.EASING_OUTQUAD, POP_RING_TIME)
	gui.animate(ring, "color.w", 0, gui.EASING_INQUAD, POP_RING_TIME, 0, function()
		gui.delete_node(ring)
	end)

	for i = 1, POP_SPARKS do
		local angle = (i + math.random() * 0.8) / POP_SPARKS * 2 * math.pi
		local dist = rand_range(POP_SPARK_DIST)
		local t = rand_range(POP_SPARK_TIME)
		local s = rand_range(POP_SPARK_SCALE)

		local spark = gui.new_box_node(pos, vmath.vector3(3, 3, 0))
		gui.set_texture(spark, "star")
		gui.play_flipbook(spark, "stars")
		gui.set_blend_mode(spark, gui.BLEND_ADD)
		gui.set_color(spark, POP_GREEN)
		gui.set_scale(spark, vmath.vector3(s, s, 1))
		gui.animate(spark, "position", pos + vmath.vector3(math.cos(angle) * dist, math.sin(angle) * dist, 0),
		gui.EASING_OUTQUAD, t)
		gui.animate(spark, "color.w", 0, gui.EASING_INQUAD, t, 0, function()
			gui.delete_node(spark)
		end)
	end
end

local function pop_slime(self, slime)
	slime.alive = false
	local pos = gui.get_position(slime.node)
	-- stop the float: a new animation on the same property replaces the running one
	gui.animate(slime.node, "position.y", pos.y, gui.EASING_LINEAR, 0.01)
	gui.set_enabled(slime.node, false)
	pop_effect(pos)
	timer.delay(RESPAWN_DELAY, false, function()
		respawn_slime(self, slime)
	end)
	msg.post("/go#bubble_pop", "play_sound")
end

local function spawn_star(self)
	if self.star_count >= STAR_MAX then return end

	local pos = vmath.vector3(math.random(8, SCREEN_W - 8), math.random(8, SCREEN_H - 8), 0)
	local node = gui.new_box_node(pos, vmath.vector3(3, 3, 0))
	gui.set_texture(node, "star")
	gui.play_flipbook(node, "stars")

	local s = STAR_SCALES[math.random(#STAR_SCALES)]
	local peak = 0.5 + math.random() * 0.5 -- some stars twinkle dimmer than others
	gui.set_scale(node, vmath.vector3(s * 0.6, s * 0.6, 1))
	gui.set_color(node, vmath.vector4(1, 1, 0.9, 0))

	-- keep stars behind the title and button
	if gui.move_above then gui.move_above(node, self.bg_node) end

	self.star_count = self.star_count + 1
	local fade_in = rand_range(STAR_FADE_IN)
	local fade_out = rand_range(STAR_FADE_OUT)

	gui.animate(node, "scale", vmath.vector3(s, s, 1), gui.EASING_OUTQUAD, fade_in)
	gui.animate(node, "color.w", peak, gui.EASING_INOUTSINE, fade_in, 0, function(self)
		gui.animate(node, "color.w", 0, gui.EASING_INOUTSINE, fade_out, rand_range(STAR_HOLD), function(self)
			gui.delete_node(node)
			self.star_count = self.star_count - 1
		end)
	end)
end

local function update_highscore()
	enemy_manager.load_high_score() -- read the saved value from disk
	gui.set_text(gui.get_node("highscore"), "High Score: " .. string.format("%04d", enemy_manager.high_score))
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.button = gui.get_node("Start button") -- hit-area + scale pivot
	self.label = gui.get_node("text") -- the visible word; tint goes here
	self.base_scale = gui.get_scale(self.button)
	self.hovering = false
	self.started = false
	self.bg_node = gui.get_node("bg")
	self.star_count = 0
	self.star_timer = 0
	self.credits_btn = gui.get_node("credits button")
	self.credits_base = gui.get_scale(self.credits_btn)
	self.credits_open = false
	self.credits_hover = false
	update_highscore()
	self.slimes = {}
	for _, id in ipairs(MENU_SLIMES) do
		local node = gui.get_node(id)
		local slime = { node = node, base = gui.get_position(node), base_scale = gui.get_scale(node), alive = true }
		table.insert(self.slimes, slime)
		start_bob(slime, math.random() * 1.5) -- staggered so they don't move in sync
	end
	msg.post("/go#main_menu_music", "play_sound", { gain = 0.6 })
end

local function set_hover(self, hovering)
	if self.hovering == hovering then return end
	self.hovering = hovering

	local target_scale = hovering and (self.base_scale * HOVER_SCALE_MULT) or self.base_scale
	local target_color = hovering and HOVER_COLOR or NORMAL_COLOR

	gui.animate(self.button, gui.PROP_SCALE, target_scale, gui.EASING_OUTQUAD, HOVER_DURATION)
	gui.animate(self.label, "color", target_color, gui.EASING_OUTQUAD, HOVER_DURATION)
end

local function start_game(self)
	if self.started then return end
	self.started = true

	for _, id in ipairs(FADE_NODES) do
		local ok, node = pcall(gui.get_node, id)
		if ok then
			gui.animate(node, "color.w", 0, gui.EASING_LINEAR, FADE_OUT_DURATION)
		end
	end

	timer.delay(FADE_OUT_DURATION, false, function()
		-- keep input focus: the game proxy lives on this same game object
		-- and only receives input while it has focus
		msg.post("#main_menu_ui", "disable")
	end)
	msg.post("#tutorial_proxy", "load")
end
local function unload_game()
	msg.post("#game_proxy", "disable")
	msg.post("#game_proxy", "final")
	msg.post("#game_proxy", "unload")
end

-- bring the menu back after leaving the game
local function show_menu(self)
	msg.post("/go#main_menu_music", "play_sound", { gain = 0.6 })
	self.started = false
	self.hovering = false
	gui.set_scale(self.button, self.base_scale)
	gui.set_color(self.label, NORMAL_COLOR)
	update_highscore()
	game_state.set_cursor_visible(true)
	for _, id in ipairs(FADE_NODES) do
		local ok, node = pcall(gui.get_node, id)
		if ok then
			gui.animate(node, "color.w", 1, gui.EASING_LINEAR, FADE_OUT_DURATION)
		end
	end
	-- a slime popped right before Start never came back; bring it back now
	for _, slime in ipairs(self.slimes) do
		if not slime.alive then respawn_slime(self, slime) end
	end

	msg.post("#main_menu_ui", "enable")
	msg.post("#main_menu_ui", "acquire_input_focus")
end
function on_input(self, action_id, action)
	if self.started then return end
	if self.credits_open then
		if action_id == hash("SHOOT") and action.pressed then
			msg.post("/go#button_click", "play_sound")
			close_credits(self)
		end
		return
	end

	if action_id == nil and action.x and action.y then
		set_credits_hover(self, gui.pick_node(self.credits_btn, action.x, action.y))
	end
	if action_id == hash("SHOOT") and action.pressed and self.credits_hover then
		msg.post("/go#button_click", "play_sound")
		open_credits(self)
		return
	end
	if action_id == nil and action.x and action.y then
		set_hover(self, gui.pick_node(self.button, action.x, action.y))
	end

	if action_id == hash("SHOOT") and action.pressed and self.hovering then
		msg.post("/go#button_click", "play_sound")
		gui.animate(self.button, gui.PROP_SCALE, self.base_scale * PRESS_SCALE_MULT, gui.EASING_OUTQUAD, PRESS_DURATION, 0, function()
			start_game(self)
		end)
	end
	if action_id == hash("SHOOT") and action.pressed then
		for _, slime in ipairs(self.slimes) do
			if slime.alive and gui.pick_node(slime.node, action.x, action.y) then
				pop_slime(self, slime)
				break
			end
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")

	elseif message_id == hash("start_main_game") then
		msg.post("/go#main_menu_music", "stop_sound")
		-- sent by the tutorial when the player clicks to continue
		msg.post("#tutorial_proxy", "disable")
		msg.post("#tutorial_proxy", "final")
		msg.post("#tutorial_proxy", "unload")
		msg.post("#game_proxy", "load")

	elseif message_id == hash("restart_game") then
		-- unload the game, then reload it once the proxy confirms it's gone
		self.pending_load = true
		unload_game()

	elseif message_id == hash("return_to_menu") then
		self.pending_load = false
		unload_game()
		show_menu(self)

	elseif message_id == hash("proxy_unloaded") then
		if self.pending_load then
			self.pending_load = false
			msg.post("#game_proxy", "load")
		end
	end
end
function update(self, dt)
	if self.started then return end
	self.star_timer = self.star_timer - dt
	if self.star_timer <= 0 then
		self.star_timer = STAR_SPAWN_MIN + math.random() * (STAR_SPAWN_MAX - STAR_SPAWN_MIN)
		spawn_star(self)
	end
end