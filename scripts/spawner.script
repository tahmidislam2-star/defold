local enemy_manager = require("scripts.enemy_manager")

local COLORS = { "red", "blue", "green", "yellow", "lime", "brown" }

local BOUND_MIN_X = 16
local BOUND_MAX_X = 416
local BOUND_MIN_Y = 20
local BOUND_MAX_Y = 342

local SPAWN_MARGIN = 120
local SPAWN_INTERVAL = 1.2   -- gap between clusters WITHIN a wave
local NEXT_WAVE_DELAY = 2.0  -- pause after a wave clears, before the next starts
local enemy_manager = require("scripts.enemy_manager")
local game_state = require("scripts.game_state")

local CLUSTER_SHAPES = {
	[1] = {{0,0}},
	[2] = {{0,0},{1,0}},
	[3] = {{0,0},{1,0},{0,1}},
	[4] = {{0,0},{1,0},{0,1},{1,1}},
	[5] = {{0,0},{1,0},{-1,0},{0,1},{0,-1}},
}

-- Bigger clusters feel heavier and move slower; solo slimes dart in fast.
local CLUSTER_SPEED_BY_SIZE = {
	[1] = 50,
	[2] = 45,
	[3] = 40,
	[4] = 32,
	[5] = 28,
}

go.property("player_id", msg.url("player"))

local function random_color()
	return COLORS[math.random(#COLORS)]
end

local function wave_target(wave_number)
	return 4 + 2 * (wave_number - 1) -- wave 1 = 4, wave 2 = 6, wave 3 = 8, ...
end

local function random_spawn_anchor()
	local edge = math.random(4)
	local x, y
	if edge == 1 then
		x = math.random(BOUND_MIN_X, BOUND_MAX_X); y = BOUND_MAX_Y + SPAWN_MARGIN
	elseif edge == 2 then
		x = math.random(BOUND_MIN_X, BOUND_MAX_X); y = BOUND_MIN_Y - SPAWN_MARGIN
	elseif edge == 3 then
		x = BOUND_MIN_X - SPAWN_MARGIN; y = math.random(BOUND_MIN_Y, BOUND_MAX_Y)
	else
		x = BOUND_MAX_X + SPAWN_MARGIN; y = math.random(BOUND_MIN_Y, BOUND_MAX_Y)
	end
	return vmath.vector3(x, y, 0)
end

-- Spawns one cluster sized at most `self.to_spawn`, returns how many it actually used.
local function spawn_cluster(self)
	local size = math.min(math.random(1, 5), self.to_spawn)
	local shape = CLUSTER_SHAPES[size]
	local anchor = random_spawn_anchor()
	local cluster_id = enemy_manager.new_cluster_id()
	local speed = CLUSTER_SPEED_BY_SIZE[size]

	enemy_manager.create_cluster(cluster_id, anchor, speed)

	for _, coord in ipairs(shape) do
		local offset = enemy_manager.hex_offset(coord[1], coord[2])
		local pos = anchor + offset
		local color = random_color()
		local id = factory.create("#enemyfactory", pos, vmath.quat_rotation_z(0))
		enemy_manager.register(id, color, cluster_id, offset)
		msg.post(id, "setup", { color = color })
	end

	return size
end

function init(self)
	-- if defos then
	-- 	defos.set_cursor_visible(false) #turn on later- mouse hide
	-- end
	self.wave_number = 1
	self.to_spawn = wave_target(self.wave_number)
	self.spawn_timer = 0.5
	self.state = "spawning"
	msg.post("/ui#panel", "update_wave", { wave_number = self.wave_number })
	enemy_manager.reset_score()
end

function update(self, dt)
	if game_state.game_over then return end

	if game_state.hitstop_timer > 0 then
		game_state.hitstop_timer = game_state.hitstop_timer - dt
		return
	end

	local player_pos = go.get_position(self.player_id)
	enemy_manager.update_clusters(dt, player_pos)

	if self.state == "spawning" then
		self.spawn_timer = self.spawn_timer - dt
		if self.spawn_timer <= 0 and self.to_spawn > 0 then
			self.spawn_timer = SPAWN_INTERVAL
			self.to_spawn = self.to_spawn - spawn_cluster(self)
		end
		if self.to_spawn <= 0 then
			self.state = "waiting_clear"
		end

	elseif self.state == "waiting_clear" then
		if enemy_manager.alive_count <= 0 then
			self.wave_number = self.wave_number + 1
			self.to_spawn = wave_target(self.wave_number)
			self.spawn_timer = NEXT_WAVE_DELAY
			self.state = "spawning"
			msg.post("/ui#panel", "update_wave", { wave_number = self.wave_number })
		end
	end
end