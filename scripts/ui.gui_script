local heart_nodes = { "heart1", "heart2", "heart3" }

-- "Wave N starting" / "Boss Level" announcement: each letter is its own
-- dynamically-created text node so it can hop into place individually, left
-- to right, Mario-coin-block style. The "wave_info" node (added in-editor)
-- supplies the position and font to use - it's never shown itself, never
-- moved, and never read for anything but those two things.
local LETTER_SPACING = 4 -- extra px between letters, before scaling
local JUMP_HEIGHT = 8
local JUMP_DURATION = 0.16
local STAGGER = 0.05 -- delay added per letter
local HOLD_DURATION = 0.9 -- fully visible, after the last letter lands
local FADE_DURATION = 0.4

local function clear_announcement(self)
	if self.announce_nodes then
		for _, node in ipairs(self.announce_nodes) do
			pcall(gui.delete_node, node)
		end
	end
	self.announce_nodes = nil
end

local function show_announcement(self, text)
	clear_announcement(self) -- cut off anything still playing from a prior call

	local anchor = gui.get_node("wave_info")
	local anchor_pos = gui.get_position(anchor)
	local font = gui.get_font(anchor) -- local font id string (e.g. "pixel"), used by gui.set_font
	local font_resource = gui.get_font_resource(font) -- needed for resource.get_text_metrics
	local scale = gui.get_scale(anchor)
	gui.set_text(anchor, "") -- wave_info stays invisible; the letters do the rendering

	local nodes = {}
	self.announce_nodes = nodes

	-- Measure each character (at scale 1) so the whole string can be centered.
	-- gui.get_text_metrics() was removed in Defold 1.13.0 - resource.get_text_metrics()
	-- is the replacement, and it needs the font RESOURCE, not the font name string.
	local widths = {}
	local total_width = 0
	for i = 1, #text do
		local ch = text:sub(i, i)
		local metrics = resource.get_text_metrics(font_resource, ch)
		local w = metrics.width + LETTER_SPACING
		widths[i] = w
		total_width = total_width + w * scale.x
	end

	local x = anchor_pos.x - total_width / 2
	for i = 1, #text do
		local ch = text:sub(i, i)
		local w = widths[i] * scale.x

		local node = gui.new_text_node(vmath.vector3(x + w / 2, anchor_pos.y, 0), ch)
		gui.set_font(node, font)
		gui.set_pivot(node, gui.PIVOT_CENTER)
		gui.set_scale(node, scale)
		table.insert(nodes, node)

		local base_pos = vmath.vector3(x + w / 2, anchor_pos.y, 0)
		local up_pos = base_pos + vmath.vector3(0, JUMP_HEIGHT, 0)
		local delay = (i - 1) * STAGGER

		gui.animate(node, gui.PROP_POSITION, up_pos, gui.EASING_OUTQUAD, JUMP_DURATION, delay, function()
			gui.animate(node, gui.PROP_POSITION, base_pos, gui.EASING_INQUAD, JUMP_DURATION)
		end)

		x = x + w
	end

	local reveal_time = (#text - 1) * STAGGER + JUMP_DURATION * 2
	timer.delay(reveal_time + HOLD_DURATION, false, function()
		-- Guard: if a newer announcement already replaced this one, its
		-- nodes table is different now - don't fade/delete someone else's.
		if self.announce_nodes ~= nodes then return end
		for _, node in ipairs(nodes) do
			gui.animate(node, "color.w", 0, gui.EASING_LINEAR, FADE_DURATION)
		end
		timer.delay(FADE_DURATION, false, function()
			if self.announce_nodes == nodes then
				clear_announcement(self)
			end
		end)
	end)
end

local function drop_heart(node)
	gui.animate(node, gui.PROP_EULER, vmath.vector3(0, 0, 15), gui.EASING_INOUTSINE, 0.08, 0, function()
		gui.animate(node, gui.PROP_EULER, vmath.vector3(0, 0, -15), gui.EASING_INOUTSINE, 0.08, 0, function()
			gui.animate(node, gui.PROP_EULER, vmath.vector3(0, 0, 0), gui.EASING_INOUTSINE, 0.08, 0, function()
				local pos = gui.get_position(node)
				gui.animate(node, gui.PROP_POSITION, pos - vmath.vector3(0, 60, 0), gui.EASING_INBACK, 0.4)
				gui.animate(node, "color.w", 0, gui.EASING_LINEAR, 0.4)
			end)
		end)
	end)
end

function init(self)
	self.hearts_remaining = 3
	msg.post(".", "acquire_input_focus")
	gui.set_enabled(gui.get_node("game_over_group"), false)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("update_queue") then
		gui.play_flipbook(gui.get_node("next1"), hash(message.c0))
		gui.play_flipbook(gui.get_node("next2"), hash(message.c1))
		gui.play_flipbook(gui.get_node("next3"), hash(message.c2))

	elseif message_id == hash("update_wave") then
		gui.set_text(gui.get_node("wave_label"), "Wave " .. message.wave_number)
		if message.is_boss then
			show_announcement(self, "BOSS LEVEL")
		else
			show_announcement(self, "WAVE " .. message.wave_number .. " STARTING")
		end

	elseif message_id == hash("update_score") then
		gui.set_text(gui.get_node("score_label"), string.format("%04d", message.score))

	elseif message_id == hash("lose_heart") then
		if self.hearts_remaining > 0 then
			drop_heart(gui.get_node(heart_nodes[self.hearts_remaining]))
			self.hearts_remaining = self.hearts_remaining - 1
		end

	elseif message_id == hash("show_game_over") then
		gui.set_enabled(gui.get_node("game_over_group"), true)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("SHOOT") and action.pressed then
		if gui.is_enabled(gui.get_node("game_over_group")) and gui.pick_node(gui.get_node("restart_button"), action.x, action.y) then
			if html5 then
				html5.run('document.location.reload();')
			else
				msg.post("@system:", "reboot")
			end
		end
	end
end